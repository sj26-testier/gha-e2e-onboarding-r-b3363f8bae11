#!/usr/bin/env bash
set -euo pipefail
if [[ "$(uname -s)" != Linux ]]; then
  echo 'Inventory importer hook requires Linux; refusing unexpected execution' >&2
  exit 1
fi
command -v python3 >/dev/null
export INVENTORY_REAL_AGENT="$(command -v buildkite-agent)"
export PATH="$BUILDKITE_BUILD_CHECKOUT_PATH/.lab/bin:$PATH"
